# Copy to .env (never commit it) and fill in, then:  set -a; source .env; set +a
# Databricks SQL warehouse: SQL Warehouses -> <warehouse> -> Connection details
DBT_DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000

# Laptop: personal access token (User settings -> Developer -> Access tokens)
DBT_TARGET=local
DBT_DATABRICKS_TOKEN=

# Later, for scheduled runs with the service principal (targets dev/test/prod)
DBT_DATABRICKS_CLIENT_ID=
DBT_DATABRICKS_CLIENT_SECRET=
